{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.4.2",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.appbuilderdemo.chwn0a",
      "infoPlist": {
        "NSCameraUsageDescription": "Tirar foto do motorista ou do veículo",
        "NSPhotoLibraryUsageDescription": "Escolher foto do motorista ou do veículo",
        "NSLocationWhenInUseUsageDescription": "Gravar as coordenadas das paradas do controle diário"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.appbuilderdemo.chwn0a",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolher foto do motorista ou do veículo",
          "cameraPermission": "Tirar foto do motorista ou do veículo"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Desbloquear o aplicativo com biometria"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Gravar as coordenadas das paradas do controle diário"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e610ac74-057a-4602-ad41-91440cff8e29"
      }
    }
  }
}
